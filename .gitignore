# 环境与密钥
.env

# 运行时产物（锚定根目录：/state 是运行时状态与加密主密钥；勿写成 state/，会误伤 src/state 源码包）
/state/
logs/
jobs/
*.db
*.db-wal
*.db-shm

# RAG 生成语料与本地 DataX 仓库（可重新灌库/克隆，不入库）
data/**/corpus/
data/datax_docs/DataX/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/

# 备份文件
*.bak

# 个人面试资产，不进远程仓库
INTERVIEW.md
INTERVIEW_QUICK.md
OPTIMIZATION.md
SUMMARY.md
INTERVIEW_FULL.md

# Bad case 回流素材与分诊状态（本地分诊队列；晋升后的 golden 用例在 evals/llm_cases/ 入库）
evals/backlog/

# 临时文件（博客资料下载等）
tmp/

# 根目录临时调试产物（手工测试脚本导出的配置/视图快照）
/tmp_*.json

# 研发知识蒸馏笔记（本地私有，同 INTERVIEW.md 不入库）
docs/dev-notes/
.playwright-cli/
logs/*.log
# 数据源加密主密钥（自动生成，切勿提交）
.secret_key
/state/.secret_key
