# ============================================================
# 数仓多 Agent 协作平台环境变量配置
# 复制为 .env 并根据实际环境修改
# ============================================================

# ---------- DataX ----------
# DATAX_HOME 必须配置为本地 DataX 安装路径
DATAX_HOME=G:\databases\datax
# DATAX_WORK_DIR 默认 <项目根>/jobs，通常无需修改
# DATAX_WORK_DIR=
DATAX_TIMEOUT=3600

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=datax_test

# ---------- MongoDB ----------
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=datax_test

# ---------- Elasticsearch ----------
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=

# ---------- StarRocks ----------
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9031
STARROCKS_USERNAME=root
# StarRocks 容器默认 root 无密码；4.0 容器 FE MySQL 协议映射到宿主机 9031
STARROCKS_PASSWORD=
STARROCKS_DATABASE=datax_test
STARROCKS_ADMIN_USERNAME=root
STARROCKS_ADMIN_PASSWORD=

# ---------- RAG ----------
RAG_COLLECTION=datax_docs
RAG_DOCS_ENABLED=true
SILICONFLOW_API_KEY=

# ---------- Web 搜索（可选）----------
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=

# ---------- LLM ----------
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=deepseek-v4-flash-ga-260731

# ---------- 按 Agent 模型覆盖（可选，模型分流降本）----------
# 缺省全部走 LLM_MODEL；按任务类型/角色指定不同模型：
#   - data_integration/data_analysis：意图解析、语义翻译、结果总结，输入输出都短
#     => 可用 Flash 类小模型（成本约旗舰 1/10~1/20）
#   - etl_development/data_ops：枚举映射设计、根因诊断，需要较强推理
#     => 建议用旗舰模型
#   - AGENT_CLASSIFY_MODEL：意图路由 LLM 兜底等 classify 角色，同样建议小模型
AGENT_DATA_INTEGRATION_MODEL=
AGENT_ETL_DEVELOPMENT_MODEL=
AGENT_DATA_OPS_MODEL=
AGENT_DATA_ANALYSIS_MODEL=
AGENT_CLASSIFY_MODEL=

# ---------- 状态存储 ----------
# 任务状态/日志/审计统一落在 <项目根>/state/tasks.db（SQLite），无需额外配置；
# LangGraph 只做编排，不另建 checkpoint 存储。
# STATE_STORE_PATH=

# ---------- 定时调度（ODS 每日增量/快照无人值守）----------
# 注册即授权：定时作业触发时自动通过审批门禁（operator=scheduler，写审计）
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30

# ---------- 数据源密码加密 ----------
# Fernet 主密钥（生成: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 留空则在 state/.secret_key 自动生成（单机可用）；多实例/生产请显式配置并妥善保管
DATASOURCE_SECRET_KEY=

# ---------- 日志（默认 <项目根>/logs/app.log）----------
LOG_LEVEL=INFO
# LOG_FILE=

# ---------- LangSmith（可选）----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dataagent

# ---------- Web API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=
MAX_CONCURRENT_TASKS=2

# ---------- 审批门禁 ----------
APPROVAL_GATE=true
REQUIRE_APPROVAL_TASK_TYPES=data_integration,etl_development
