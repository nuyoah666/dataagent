# ============================================================
# 数仓多 Agent 协作平台环境变量配置 (示例)
# 复制本文件为 .env 并根据实际环境修改
# ============================================================

# ---------- DataX ----------
DATAX_HOME=G:\databases\datax
DATAX_WORK_DIR=F:\dataagent\jobs
DATAX_TIMEOUT=3600

# ---------- MySQL 8.0 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=datax_test

# ---------- MongoDB 8.0 ----------
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=datax_test

# ---------- Elasticsearch ----------
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=

# ---------- StarRocks (容器部署, FE MySQL 协议) ----------
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
STARROCKS_USERNAME=datax
STARROCKS_PASSWORD=your_starrocks_password
STARROCKS_DATABASE=datax_test

# ---------- RAG 项目路径 ----------
RAG_PROJECT_PATH=F:\PycharmProjects\pyspark\MyRag
RAG_COLLECTION=datax_docs

# ---------- 运维事故知识库 ----------
OPS_INCIDENT_STORE=F:\dataagent\data\ops_incidents\incidents.jsonl

# ---------- LLM (MiMo) ----------
LLM_API_KEY=your_mimo_api_key
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro

# ---------- 按 Agent 模型覆盖（可选）----------
# 缺省为空 => 所有 Agent 使用上面的 LLM_MODEL；
# 配置后仅对应任务类型的 Agent 使用指定模型
# （如：意图解析/配置生成用便宜模型，运维诊断用更强的模型）
AGENT_DATA_INTEGRATION_MODEL=
AGENT_ETL_DEVELOPMENT_MODEL=
AGENT_DATA_OPS_MODEL=
AGENT_DATA_ANALYSIS_MODEL=

# ---------- LangGraph 状态存储 ----------
# 可选: memory | sqlite | mysql
STATE_STORE_TYPE=sqlite
STATE_STORE_PATH=F:\dataagent\state\checkpoints.db

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=F:\dataagent\logs\app.log

# ---------- LangSmith 追踪 (可选) ----------
# 在 smith.langchain.com 注册获取 API Key 后填入即可启用，
# LangGraph 每个节点的 LLM 调用会自动上报；留空则完全离线。
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dataagent

# ---------- Web API ----------
API_HOST=0.0.0.0
API_PORT=8000
# 可选：配置后除 /health /ui /metrics 外均需 Authorization: Bearer <token>
API_TOKEN=
MAX_CONCURRENT_TASKS=2

# ---------- 人工审批门禁 ----------
# 集成/ETL 任务生成配置后需人工确认才执行；false 关闭（回到全自动）
APPROVAL_GATE=true
REQUIRE_APPROVAL_TASK_TYPES=data_integration,etl_development
